# =============================================================================
# GLM-5.3-Flash  ·  NVIDIA official NVFP4  ·  DFlash2  ·  2x DGX Spark TP=2
# =============================================================================
# Copy this file to .env, edit the [EDIT] lines for your cluster, then:
#
#   ./download.sh        # image + NVIDIA weights + DFlash2 draft on BOTH nodes
#   ./start.sh           # boot, wait for health, print KV pool
#   ./status.sh          # containers, health, served model, pool
#   ./run-tests.sh       # spec-bench x2 -> throughput -> hardmode
#   ./stop.sh            # stop both nodes
#
# Current long-context profile: 900,096 ctx, GMU 0.88, 9 GiB KV pin,
# seqs 4, batch 1024, cudagraphs <=16 + async + DFlash2 k=5.
# Prior measured baseline: 700,160 ctx, 94/100, 892,139-token pool, 32.5-33.1 t/s.
# See docs/FINDINGS.md for measurements and failure traces.
# =============================================================================

# --- Docker image (the recipe's runtime; supplies b12x backends) ---
IMAGE=pilcothink/vllm_spark_glm53:0.28

# --- Weights: NVIDIA official NVFP4 ---
MODEL_REPO=nvidia/GLM-5.3-Flash-NVFP4
# Pin the revision: an unpinned repo silently changes the artifact under you.
MODEL_REVISION=<commit-sha-from-hf>
# Empty = serve under the model path. Set to rename, e.g. glm-5.3-flash
SERVED_MODEL_NAME=

# --- Speculative decoding: DFlash2 draft ---
# The official NVFP4 checkpoint ships NO MTP heads, so a separate draft model is
# required (unlike the local-inference-lab weights, which carry native MTP).
DRAFT_MOUNT_DIR=/home/<user>/models
DRAFT_NAME=glm53-dflash2-orig
K=5
RECIPE_SPEC_EXTRAS=1

# --- Cache directories (absolute, per node) ---  [EDIT]
HF_CACHE=/home/<user>/.cache/huggingface

# --- RoCE fabric ---  [EDIT]
# Find yours: ibstat | grep -E 'CA|hca_id'  and  ip -br addr | grep <roce-subnet>
MN_IF=enpXsXfXnpX
HCAS=rocepXsXfX,rocePXpXfX

# --- Cluster IPs (RoCE / backend network) ---  [EDIT]
HEAD_IP=192.168.0.1
WORKER_IP=192.168.0.2
WORKER_SSH_TARGET=<user>@192.168.0.2
WORKER_ROCE_SSH_TARGET=<user>@192.168.0.2
WORKER_DIR=/home/<user>/dockers/GLM53F-NvidiaNVFP4-DFlash

# --- Serving ---
PORT=8100
MASTER_PORT=29503
CONTAINER=glm53f-nvidia
TP_SIZE=2

# --- Memory ---
# The local 900K profile uses the upstream DFlash2 long-context allocation:
# a 9 GiB KV pin. GMU remains the engine admission budget and does not get
# second-guessed by a static launcher-side memory check.
GMU=0.88
KV_CACHE_MEMORY=9663676416  # 9 GiB; upstream uses this for its 1M DFlash2 profile

# --- Context & schedule ---
CTX=900096            # 3,516 x 256
SEQS=4
BATCH=1024            # batch/seqs trade directly against KV pool size

# --- CUDA graphs / scheduling ---
ENFORCE_EAGER=0
CAPTURE_SIZE=16       # a KV-budget lever, not just a perf knob (see docs/FINDINGS.md)
ASYNC_SCHED=1
# vLLM >= v0.21: in graph mode the CUDA-graph memory estimator reserves ~2.1 GiB of
# KV. Disable when the pool is the binding constraint and capture is small.
ESTIMATE_CUDAGRAPHS=0

# --- Optional ---
ATTN_BACKEND=         # empty = image default (as the recipe does)
TEST_PARALLEL=4       # hardmode parallelism (byte-matched for comparability)
TEST_SEED=42
TEST_MAX_TURNS=32
TEST_TIMEOUT=360
TEST_DEPTHS=0,2048,8192
TEST_TOKENIZER=       # empty = derived from HF_CACHE/MODEL_REPO/MODEL_REVISION
