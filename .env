# =============================================================================
# GLM-5.3-Flash  ·  NVIDIA official NVFP4  ·  DFlash2  ·  2x DGX Spark TP=2
# =============================================================================
# VERIFIED CONFIG (2026-09-13): 700,160 ctx · GMU 0.88 · seqs 4 · batch 1024
#   cudagraphs <=16 + async + DFlash2 k=5  ->  hardmode 94/100 (166/176),
#   Hard Mode 38/38, e2e 996 s, KV pool 892,139 tokens.
#   Full record: docs/FINDINGS.md
#
#   ./download.sh        # image + NVIDIA weights + DFlash2 draft on BOTH nodes
#   ./start.sh           # boot, wait for health, print KV pool
#   ./status.sh          # containers, health, served model, pool
#   ./run-tests.sh       # spec-bench x2 -> throughput -> hardmode
#   ./stop.sh            # stop both nodes
#   ./tail-log.sh        # follow the latest boot log
#
# Site-specific values are marked [EDIT].
# =============================================================================

# --- Docker image (the recipe's runtime; supplies b12x backends) ---
IMAGE=pilcothink/vllm_spark_glm53:0.28

# --- Weights: NVIDIA official NVFP4 (uniform NVFP4, 204 GB) ---
MODEL_REPO=nvidia/GLM-5.3-Flash-NVFP4
# HF main @ 2026-09-11. Pin it: an unpinned repo silently changes the artifact.
MODEL_REVISION=09b04e5e74bca08ca8549fc736d4cdd8624bfde3
# Empty = serve under the model path (recipe default). Set to rename, e.g. glm-5.3-flash
SERVED_MODEL_NAME=

# --- Speculative decoding: DFlash2 draft (k=5 is the tested operating point) ---
# NOTE: the official NVFP4 checkpoint ships NO MTP heads (0 mtp/nextn tensors),
# so a separate draft model is required here — unlike our LIL weights.
DRAFT_MOUNT_DIR=/home/xraan/models
DRAFT_NAME=glm53-dflash2-orig
K=5
RECIPE_SPEC_EXTRAS=1          # the pilcothink image accepts the 4 extra DFlash2 knobs

# --- Cache directories (absolute, per node) ---  [EDIT]
HF_CACHE=/home/xraan/.cache/huggingface

# --- RoCE fabric ---  [EDIT]
# Find yours: ibstat | grep -E 'CA|hca_id'  and  ip -br addr | grep <roce-subnet>
MN_IF=enp1s0f0np0             # NCCL_SOCKET_IFNAME / GLOO / control interface
HCAS=rocep1s0f0,roceP2p1f0    # NCCL_IB_HCA (comma-separated)

# --- Cluster IPs (RoCE / backend network) ---  [EDIT]
HEAD_IP=192.168.0.8           # head node's RoCE IP
WORKER_IP=192.168.0.88        # worker node's RoCE IP
WORKER_SSH_TARGET=xraan@192.168.0.88
WORKER_ROCE_SSH_TARGET=xraan@192.168.0.88
WORKER_DIR=/home/xraan/dockers/GLM53F-NvidiaNVFP4-DFlash

# --- Serving ---
PORT=8100
MASTER_PORT=29503
CONTAINER=glm53f-nvidia
TP_SIZE=2

# --- Memory ---
# GMU on GB10 is a fraction of *system* RAM (121.69 GiB total), and the pilcothink
# image enforces it as a FATAL pre-load check. Measured ceiling on this box: ~0.88.
# 0.89/0.895 CANNOT boot here (they demand 108.30/108.91 GiB free at engine init).
GMU=0.88
# Static preflight reference: free GiB the launcher assumes is available for CUDA.
# Raise it only after MEASURING free memory at engine init on this build.
CUDA_FREE_REF=116
TOTAL_REF=121.69
# Optional explicit KV pin (bytes). Empty = GMU-driven sizing (preferred).
# WARNING: the pin does NOT bypass the GMU gate — the worker still runs it first.
KV_CACHE_MEMORY=
# Abort the boot wait if MemAvailable is below this (GiB).
MIN_MEMAVAIL_GIB=110

# --- Context & schedule ---
CTX=700160                    # 2,735 x 256 — 700K rounded UP to the 256 block
SEQS=4
BATCH=1024
# Batch 1024 + 4 seqs bought +2.0 GiB of KV pool vs batch 2048 + 10 seqs.
# Larger batches take RAM away from KV cache hard; they are not needed for quality.

# --- CUDA graphs / scheduling ---
ENFORCE_EAGER=0               # 1 = eager. Do NOT enable for perf runs: graphs are the point.
CAPTURE_SIZE=16               # --max-cudagraph-capture-size. Capture size is a KV lever:
                              # <=64 costs ~4 GiB of pool vs eager; <=16 returns ~3.6 GiB.
ASYNC_SCHED=1                 # recipe omits it; without it prefills choke running decodes.
# CRITICAL (vLLM >= v0.21): in graph mode the CUDA-graph memory estimator reserves
# ~2.1 GiB of the KV budget and logs "equivalent to GMU 0.8642". With capture <=16
# that estimate is pure waste (the capture actually freed 0.74 GiB). 0 = disable.
ESTIMATE_CUDAGRAPHS=0

# --- Optional: attention backend (empty = image default, as the recipe does) ---
ATTN_BACKEND=

# --- Test suite knobs (run-tests.sh / replicate-hardmode.sh) ---
# The hardmode invocation is byte-matched for comparability — change knowingly.
TEST_PARALLEL=4
TEST_SEED=42
TEST_MAX_TURNS=32
TEST_TIMEOUT=360
TEST_DEPTHS=0,2048,8192
# Empty = derived from HF_CACHE / MODEL_REPO / MODEL_REVISION
TEST_TOKENIZER=
